# Frontend (Vite) — safe to expose in browser
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: custom endpoint for the MILO AI server-side adapter (defaults to Supabase Edge Function /functions/v1/milo-chat)
VITE_MILO_API_URL=

# Server-side ONLY (Supabase Edge Function / Node server secrets — NEVER prefix with VITE_)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional AI provider configuration for broader MILO financial Q&A
# Supported AI_PROVIDER values: openai | gemini | anthropic | openai_compatible
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
